<?xml version="1.0" encoding="utf-8"?>
<!--
  The package-sources of this repository. "clear" drops whatever is configured on the machine of the developer,
  so the build does not depend on it and everyone (including the pipeline) resolves the same packages. All
  packages of this product - the own ones as well - are published on nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
