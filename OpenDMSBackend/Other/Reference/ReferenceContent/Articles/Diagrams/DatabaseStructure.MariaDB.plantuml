@startuml
title OpenDMSBackend - Database structure (MariaDB)
hide circle
skinparam linetype ortho

entity "AccessToken" {
  * Value : varchar <<PK>>
  --
  ExpiredMoment : datetime <<NOT NULL>>
  UserId : varchar <<NOT NULL>>
}

entity "Container_Containee" {
  * ContaineeId : varchar <<PK>>
  * ContainerId : varchar <<PK>>
}

entity "DocumentVersion" {
  * ContentId : varchar <<PK>>
  --
  DocumentId : varchar <<NOT NULL>>
  Timestamp : datetime <<NOT NULL>>
  Version : int <<NOT NULL>>
}

entity "Document_MetadataValue" {
  * DocumentId : varchar <<PK>>
  * MetadataFieldDefinitionId : varchar <<PK>>
  --
  Value : longtext <<NOT NULL>>
}

entity "Document_Tag" {
  * DocumentId : varchar <<PK>>
  * TagId : varchar <<PK>>
}

entity "Documents" {
  * Id : varchar <<PK>>
  --
  AISummaryLong : longtext
  AISummaryShort : longtext
  AddedByUserId : varchar
  AssignedLanguages : varchar
  DeleteIsNotAllowedBefore : datetime
  Filename : varchar <<NOT NULL>>
  GroupOfBusinessOwner : varchar <<NOT NULL>>
  ImportDate : datetime <<NOT NULL>>
  IsHardDeleted : tinyint <<NOT NULL>>
  IsLatestVersion : tinyint <<NOT NULL>>
  IsSoftDeleted : tinyint <<NOT NULL>>
  MIMEType : varchar <<NOT NULL>>
  MustBeHardDeletedAfter : datetime
  OCRContent : longtext <<NOT NULL>>
  OriginalFilename : varchar <<NOT NULL>>
  ReadableId : bigint <<NOT NULL>>
  Title : varchar <<NOT NULL>>
}

entity "Folders" {
  * Id : varchar <<PK>>
  --
  Name : varchar <<NOT NULL>>
}

entity "MetadataFieldDefinitions" {
  * Id : varchar <<PK>>
  --
  Name : varchar <<NOT NULL>>
  StorageLocationId : varchar <<NOT NULL>>
  Type : varchar <<NOT NULL>>
}

entity "RefreshToken" {
  * Value : varchar <<PK>>
  --
  ExpiredMoment : datetime <<NOT NULL>>
  UserId : varchar <<NOT NULL>>
}

entity "Role_InheritedRoles" {
  * InheritedRoleId : varchar <<PK>>
  * RoleId : varchar <<PK>>
}

entity "Roles" {
  * Id : varchar <<PK>>
  --
  Name : varchar <<NOT NULL>>
}

entity "Settings" {
  * Key : varchar <<PK>>
  --
  Value : longtext <<NOT NULL>>
}

entity "StorageLocation_UserPermission" {
  * StorageLocationId : varchar <<PK>>
  * UserId : varchar <<PK>>
  --
  CanEdit : tinyint <<NOT NULL>>
}

entity "StorageLocations" {
  * Id : varchar <<PK>>
  --
  Name : varchar <<NOT NULL>>
}

entity "StorageLocations_User" {
  * StorageLocationId : varchar <<PK>>
  * UserId : varchar <<PK>>
}

entity "Tags" {
  * Id : varchar <<PK>>
  --
  Color : int <<NOT NULL>>
  Name : varchar <<NOT NULL>>
  OwnerUserId : varchar
}

entity "UserSettings" {
  * Key : varchar <<PK>>
  * UserId : varchar <<PK>>
  --
  Value : longtext <<NOT NULL>>
}

entity "User_Roles" {
  * RoleId : varchar <<PK>>
  * UserId : varchar <<PK>>
}

entity "Users" {
  * Id : varchar <<PK>>
  --
  EMailAddress : varchar
  ExternalLoginProvider : varchar
  ExternalLoginSubject : varchar
  Name : varchar <<NOT NULL>>
  PasswordHash : varchar
  RegistrationMoment : datetime <<NOT NULL>>
  TOTPActivated : tinyint
  TOTPSecretKey : varchar
  UserIsActivated : tinyint <<NOT NULL>>
  UserIsLocked : tinyint <<NOT NULL>>
}

"AccessToken" }o--|| "Users" : UserId
"DocumentVersion" }o--|| "Documents" : ContentId
"RefreshToken" }o--|| "Users" : UserId
"Role_InheritedRoles" }o--|| "Roles" : InheritedRoleId
"Role_InheritedRoles" }o--|| "Roles" : RoleId
"User_Roles" }o--|| "Roles" : RoleId
"User_Roles" }o--|| "Users" : UserId
@enduml
