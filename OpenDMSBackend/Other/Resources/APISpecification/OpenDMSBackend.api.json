    "/API/v3/OpenDMSBackend/AddDocument/{containerId}": {
      "post": {
        "tags": [
          "OpenDMSBackend"
        ],
        "summary": "Uploads a new document into the specified container.",
        "parameters": [
          {
            "name": "containerId",
            "in": "path",
            "description": "The ID of the container (folder or storage location) to add the document to.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filename",
            "in": "query",
            "description": "The file name for the uploaded document.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "description": "An optional display title for the document.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "additionalOCRLanguages",
            "in": "query",
            "description": "Additional languages to use during OCR processing.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "X-AccessToken",
            "in": "header",
            "description": "Access Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "The raw binary content of the document.",
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "format": "byte"
              }
            },
            "text/json": {
              "schema": {
                "type": "string",
                "format": "byte"
              }
            },
            "application/*+json": {
              "schema": {
                "type": "string",
                "format": "byte"
              }
            },
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "byte"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
