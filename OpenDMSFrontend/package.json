{
  "name": "open-dms",
  "version": "3.1.0",
  "scripts": {
    "build": "npm run build-QualityCheck",
    "build-Development": "ng build --configuration Development",
    "build-QualityCheck": "ng build --configuration QualityCheck",
    "build-Productive": "ng build --configuration Productive",
    "test": "npm run test-QualityCheck",
    "test-Development": "ng test --configuration Development --browsers ChromeHeadless --watch false",
    "test-QualityCheck": "ng test --configuration QualityCheck --browsers ChromeHeadless --watch false",
    "test-Productive": "ng test --configuration Productive --browsers ChromeHeadless --watch false",
    "start": "ng serve --configuration Development --host 0.0.0.0 --live-reload=false --disable-host-check",
    "lint": "ng lint",
    "extract-translations": "ng extract-i18n"
  },
  "dependencies": {
    "@angular/animations": "20.3.27",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.27",
    "@angular/compiler": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/forms": "20.3.27",
    "@angular/localize": "20.3.27",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.27",
    "@angular/platform-browser-dynamic": "20.3.27",
    "@angular/router": "20.3.27",
    "@aniondev/ngx-darkmode-toggle-button": "2.0.1",
    "@fontsource/material-icons": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "file-saver": "2.0.5",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.33",
    "@angular-eslint/schematics": "19.0.2",
    "@angular/cli": "20.3.33",
    "@angular/compiler-cli": "20.3.27",
    "@playwright/test": "1.62.1",
    "@types/file-saver": "2.0.7",
    "@types/jasmine": "5.1.7",
    "angular-eslint": "19.2.0",
    "eslint": "9.21.0",
    "jasmine-core": "5.6.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.15.0"
  }
}
